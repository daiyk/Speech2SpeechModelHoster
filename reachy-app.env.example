# Set these in the Reachy Mini Conversation App, not in this server.
# Saved app settings override env defaults; use the app's Connection settings.
HF_REALTIME_CONNECTION_MODE=local
HF_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime
# For an app running on Reachy Mini Wireless, replace 127.0.0.1 with the Mac LAN IP.
